import sqlite
import os

fn fail(message) { print(message); os.exit(1) }
fn main() {
  match sqlite.open(":memory:") {
    Err(_) -> fail("FAIL open memory")
    Ok(db) -> {
      match sqlite.exec(db, "create table t (id integer, name text)") {
        Err(_) -> fail("FAIL create")
        Ok(_) -> 0
      }
      match sqlite.exec(db, "insert into t values (7, 'Ada')") {
        Err(_) -> fail("FAIL insert")
        Ok(_) -> 0
      }
      match sqlite.prepare(db, "select id, name from t") {
        Err(_) -> fail("FAIL prepare")
        Ok(stmt) -> {
          match sqlite.next(stmt) {
            Ok(true) -> {
                            if sqlite.column_text(stmt, 0) == "7" {
                if sqlite.column_text(stmt, 1) == "Ada" {
                                    let values = sqlite.row(stmt)
                  if null?(values) { fail("FAIL sqlite.row(): returned nil; dylib missing? See docs/packages.md troubleshooting") }
                  if car(car(values)) == "id" {
                    if cdr(car(values)) == "7" { print("PASS row list-of-pairs") } else { fail("FAIL row value") }
                  } else { fail("FAIL row column name") }
                  print("PASS sqlite smoke")
                } else { fail("FAIL name") }
              } else { fail("FAIL id") }
            }
            _ -> fail("FAIL row missing")
          }
          sqlite.finalize(stmt)
        }
      }
      sqlite.close(db)
    }
  }
}
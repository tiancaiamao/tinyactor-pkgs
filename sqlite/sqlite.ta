// SQLite package API
// Handles are mutable opaque integers. Raw C failures are -1; nil is reserved
// for retryable absence. The TA layer exposes Result for open/prepare/exec and
// next; close/finalize return Result(unit). Rows are lists of (column name,
// text value) pairs: this preserves column names/order and can be folded into
// the project's dict API without adding a package-specific map representation.
import result

external fn sqlite.raw_open(string) -> int
external fn sqlite.raw_open_error() -> string
external fn sqlite.raw_close(int) -> int
external fn sqlite.raw_exec(int, string) -> int
external fn sqlite.raw_error(int) -> string
external fn sqlite.raw_prepare(int, string) -> int
external fn sqlite.raw_step(int) -> int
external fn sqlite.raw_column_count(int) -> int
external fn sqlite.raw_column_name(int, int) -> a
external fn sqlite.raw_column_text(int, int) -> a
external fn sqlite.raw_bind_int(int, int, int) -> int
external fn sqlite.raw_bind_text(int, int, string) -> int
external fn sqlite.raw_finalize(int) -> int

pub fn open(path: string) -> Result(int, string) {
  match sqlite.raw_open(path) {
    -1 -> Err(sqlite.raw_open_error())
    db -> Ok(db)
  }
}
pub fn error(db: int) -> string { sqlite.raw_error(db) }
pub fn close(db: int) -> Result(unit, string) {
  match sqlite.raw_close(db) {
    -1 -> Err(sqlite.error(db))
    _ -> Ok(())
  }
}
pub fn exec(db: int, sql: string) -> Result(int, string) {
  match sqlite.raw_exec(db, sql) {
    -1 -> Err(sqlite.error(db))
    count -> Ok(count)
  }
}
pub fn prepare(db: int, sql: string) -> Result(int, string) {
  match sqlite.raw_prepare(db, sql) {
    -1 -> Err(sqlite.error(db))
    stmt -> Ok(stmt)
  }
}
pub fn next(stmt: int) -> Result(bool, string) {
  match sqlite.raw_step(stmt) {
    -1 -> Err("step failed")
    0 -> Ok(false)
    1 -> Ok(true)
  }
}
pub fn row(stmt: int) -> List(Pair(string, string)) {
  row_columns(stmt, sqlite.raw_column_count(stmt), 0, nil)
}
fn row_columns(stmt: int, count: int, index: int, acc) {
  if index >= count {
    reverse(acc)
  } else {
    let name = sqlite.raw_column_name(stmt, index)
    let value = sqlite.raw_column_text(stmt, index)
    row_columns(stmt, count, index + 1, cons(cons(name, value), acc))
  }
}
fn reverse(xs) {
  reverse_into(xs, nil)
}
fn reverse_into(xs, acc) {
  match xs {
    nil -> acc
    _ -> reverse_into(cdr(xs), cons(car(xs), acc))
  }
}
pub fn column_count(stmt: int) -> int { sqlite.raw_column_count(stmt) }
pub fn column_name(stmt: int, index: int) -> string { sqlite.raw_column_name(stmt, index) }
pub fn column_text(stmt: int, index: int) -> string { sqlite.raw_column_text(stmt, index) }
pub fn bind_int(stmt: int, index: int, value: int) -> Result(unit, string) {
  match sqlite.raw_bind_int(stmt, index, value) {
    -1 -> Err("bind failed")
    _ -> Ok(())
  }
}
pub fn bind_text(stmt: int, index: int, value: string) -> Result(unit, string) {
  match sqlite.raw_bind_text(stmt, index, value) {
    -1 -> Err("bind failed")
    _ -> Ok(())
  }
}
pub fn finalize(stmt: int) -> Result(unit, string) {
  match sqlite.raw_finalize(stmt) {
    -1 -> Err("finalize failed")
    _ -> Ok(())
  }
}
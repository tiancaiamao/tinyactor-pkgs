import "tinyactor-pkgs:sdl/sdl"
import "tinyactor:lib/os"
import "tinyactor:lib/result"
import "tinyactor:lib/option"

fn fail(message) { print(message); os.exit(1) }
fn main() {
  match sdl.init() {
    result.Err(_) -> fail("FAIL SDL init")
    result.Ok(_) -> 0
  }
  match sdl.poll_event() {
        option.None -> print("PASS no pending event")
    option.Some(_) -> fail("FAIL unexpected event")
  }
  match sdl.delay(1) {
    result.Err(_) -> fail("FAIL delay")
    result.Ok(_) -> print("PASS delay")
  }
  match sdl.create_window("tinyactor-sdl-smoke", 64, 64) {
    result.Err(_) -> fail("FAIL dummy window")
    result.Ok(window) -> {
      match sdl.destroy_window(window) {
        result.Err(_) -> fail("FAIL destroy window")
        result.Ok(_) -> print("PASS window lifecycle")
      }
    }
  }
  match sdl.quit() {
    result.Err(_) -> fail("FAIL SDL quit")
    result.Ok(_) -> print("PASS SDL smoke")
  }
}
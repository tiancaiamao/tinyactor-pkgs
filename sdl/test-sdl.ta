import "tinyactor-pkgs:sdl/sdl"
import "tinyactor:lib/os"
import "tinyactor:lib/result"
import "tinyactor:lib/option"

fn fail(message) { print(message); os.exit(1) }
fn main() {
  match sdl.init() {
        result.Err(_) -> fail("FAIL init")
    result.Ok(_) -> 0
  }
  match sdl.create_window("tinyactor-sdl-test", 32, 32) {
        result.Err(_) -> fail("FAIL create window")
    result.Ok(window) -> {
      match sdl.poll_event() {
        option.None -> print("PASS empty event queue")
        option.Some(_) -> print("PASS event queue")
      }
      match sdl.delay(2) { result.Ok(_) -> print("PASS timer delay"); _ -> fail("FAIL delay") }
            match sdl.destroy_window(window) {
        result.Err(_) -> fail("FAIL destroy")
        result.Ok(_) -> print("PASS destroy")
      }
      match sdl.destroy_window(window) {
        result.Err(_) -> print("PASS closed window rejected")
        _ -> fail("FAIL closed window accepted")
      }

    }
  }
  match sdl.delay(-1) {
    result.Err(_) -> print("PASS invalid delay rejected")
    _ -> fail("FAIL invalid delay accepted")
  }
  match sdl.quit() { result.Ok(_) -> print("PASS SDL quit"); _ -> fail("FAIL quit") }
  print("PASS sdl tests")
}